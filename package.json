{
  "name": "discord-bot-host",
  "version": "0.1.0",
  "private": true,
  "description": "Single Heroku dyno running multiple Discord bots (Pizzabot, TheCribMC, Comskies, …)",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "heroku-postbuild": "node scripts/fetch-uplb.mjs && npm run build",
    "register-commands": "bun src/register-commands.ts",
    "register-commands:all": "bun src/register-commands.ts all",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "lint": "biome check .",
    "check": "biome check . && bun run typecheck && bun test src && bun run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
